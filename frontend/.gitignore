# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependency directories
# Node.js 패키지 설치 폴더
node_modules/

# Build output
# Vite 빌드 결과물
dist/
dist-ssr/

# Environment variables
# 로컬/배포 환경 변수 파일
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Local files
*.local

# Cache / temp
# 빌드 도구 및 개발 환경 캐시
.cache/
.temp/
.tmp/
.vite/

# Test / coverage
# 테스트 커버리지 결과물
coverage/

# Package manager cache
# npm/yarn/pnpm 등 패키지 매니저 캐시성 파일
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ESLint / Prettier cache
# 린트/포맷 캐시 파일
.eslintcache
.prettiercache

# TypeScript
# TypeScript 빌드 캐시 파일
*.tsbuildinfo

# Editor directories and files
# 개인 IDE/에디터 설정 파일. 팀 공통 설정 아니면 제외
.vscode/*
!.vscode/extensions.json
.idea/

# OS files
.DS_Store
Thumbs.db

# Visual Studio / Windows project files
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?